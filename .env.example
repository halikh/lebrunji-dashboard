# The dashboard's entire configuration.
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# Both of these are `NEXT_PUBLIC_`, which means **inlined into the browser
# bundle and readable by anyone with the URL**. That is correct for a hostname,
# and correct for the anon key, whose security model is Row-Level Security —
# it grants nothing on its own. It is correct for nothing else.
#
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Local-only. Never set these on Vercel.
# ---------------------------------------------------------------------------
#
# The service-role key bypasses RLS completely. It is used by exactly one thing
# — `npm run create-admin`, run once from your own machine to create the single
# operator account. If it ever reaches the deployed environment, every policy in
# migrations 0062-0064 stops meaning anything.
#
# A different key from the anon key above, not the same one renamed. The anon
# key is refused by the admin API and cannot write to `admins`, which has no
# insert policy. No NEXT_PUBLIC_ prefix on purpose: this one bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Used by `npm run check:limits`, which reads the CHECK constraints back out of
# the database to prove src/lib/limits.ts still describes it.
# Project Settings -> Database -> Connection string (pooler).
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Object storage for uploaded pictures
# ---------------------------------------------------------------------------
#
# Shop, dish, category and promotion images. Set on Vercel as well as locally —
# unlike the two above, the dashboard cannot work without these.
#
# NO `NEXT_PUBLIC_` PREFIX ON ANY OF THEM, and the secret in particular. This
# key is not scoped to a user and RLS has no opinion about it: whoever holds it
# can read, overwrite and delete every object in the bucket. Inlined into the
# bundle it would be readable by anyone who opens the dashboard.
#
# It is the only privileged credential in the deployed app. `src/lib/storage/
# bucket.ts` is `server-only` so that a component importing it fails the build
# rather than shipping the key, and `requireOperator` is the hand-written check
# standing in for the RLS policy the bucket cannot have.
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# This deployment's own address, e.g. https://dashboard.lebrunji.com
#
# Uploaded images are served back through `/i/<key>` on this origin, and that
# URL is written into `image_url` — where it outlives the request that made it.
# Taken from the incoming request instead, a picture uploaded from a Vercel
# preview would be stored as a preview URL and become a dead image in the
# customer app the moment that deployment is cleaned up.
#
# Leave empty locally; the request's own origin is right and is all there is.
APP_PUBLIC_URL=

# Only if the storage account ever exposes a public or CDN domain for the
# bucket. Set it and new uploads get a direct URL, skipping `/i/` entirely —
# rows already written keep working, because that route stays valid.
#
# Empty today: this bucket has no public read at all. Objects 403 unsigned, the
# bucket-policy API answers NotImplemented, and a public-read ACL is accepted
# and ignored.
S3_PUBLIC_BASE_URL=
