{
  "name": "lebrunji-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/use-env.mjs dev && next dev",
    "staging": "node scripts/use-env.mjs staging && next dev",
    "prod": "node scripts/use-env.mjs prod && next dev",
    "env": "node scripts/use-env.mjs",
    "env:dev": "node scripts/use-env.mjs dev",
    "env:staging": "node scripts/use-env.mjs staging",
    "env:prod": "node scripts/use-env.mjs prod",
    "ship": "node scripts/ship.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "db:types": "tsx scripts/db-types.ts",
    "check:limits": "tsx scripts/check-limits.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "import:brand-art": "tsx scripts/import-brand-art.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@dnd-kit/core": "^6.3.1",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.3",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "postgres": "^3.4.5",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.0.5"
  }
}
